{
  // ---------- Build tools ----------
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],

  // latexmk is the default: it reruns until refs/links settle and keeps fdb_latexmk
  // so unchanged builds are near-instant.
  "latex-workshop.latex.recipes": [
    { "name": "latexmk (pdflatex)", "tools": ["latexmk"] },
    { "name": "pdflatex x2", "tools": ["pdflatex", "pdflatex"] }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (pdflatex)",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": true,

  // Aux files are junk; keep them out of the way but never delete .synctex.gz
  // (it powers Ctrl+Click from PDF back to source).
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.fls",
    "*.fdb_latexmk",
    "*.out",
    "*.toc",
    "*.xdv"
  ],

  // ---------- PDF viewer ----------
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.synctex.afterBuild.enabled": true,

  // ---------- Feedback ----------
  "latex-workshop.message.error.show": true,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.message.badbox.show": false,
  "latex-workshop.intellisense.package.enabled": true,
  "latex-workshop.formatting.latex": "latexindent",

  // ---------- Editor ----------
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2,
    "editor.formatOnSave": false,
    "editor.rulers": [100]
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.tex": "${capture}.pdf, ${capture}.log, ${capture}.aux, ${capture}.synctex.gz"
  }
}
